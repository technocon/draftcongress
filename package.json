{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "dotenv -e .env -- vitest run",
    "test:watch": "dotenv -e .env -- vitest",
    "db:migrate": "dotenv -e .env -- prisma migrate dev",
    "db:migrate:deploy": "dotenv -e .env -- prisma migrate deploy",
    "db:seed": "dotenv -e .env -- tsx prisma/seed.ts",
    "db:studio": "dotenv -e .env -- prisma studio",
    "db:import-congress-members": "dotenv -e .env -- tsx scripts/import-congress-members.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "echarts": "^6.1.0",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^22.6.2",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^24.13.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "d3-geo": "^3.1.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "us-atlas": "^3.0.1",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
